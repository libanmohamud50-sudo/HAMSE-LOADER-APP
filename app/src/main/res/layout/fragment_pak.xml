<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#000000">

    <TextView android:text="PAK Tool" android:textColor="#00BCD4" android:textSize="20sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/et_pak_path" android:hint="PAK file path / source dir"
        android:textColorHint="#888" android:textColor="#FFF" android:background="#1A1A1A"
        android:padding="10dp" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

    <EditText android:id="@+id/et_out_path" android:hint="Output directory / output .pak path"
        android:textColorHint="#888" android:textColor="#FFF" android:background="#1A1A1A"
        android:padding="10dp" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

    <Button android:id="@+id/btn_unpack" android:text="Unpack PAK"
        android:backgroundTint="#00BCD4" android:textColor="#000"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button android:id="@+id/btn_repack" android:text="Repack PAK"
        android:backgroundTint="#0097A7" android:textColor="#FFF"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <TextView android:id="@+id/tv_pak_output" android:text="Output..."
            android:textColor="#AAAAAA" android:padding="8dp" android:background="#0D0D0D"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace"/>
    </ScrollView>
</LinearLayout>
